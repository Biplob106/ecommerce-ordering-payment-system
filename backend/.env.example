# ===========================================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env        (or on Windows: copy .env.example .env)
#
# `.env` is gitignored and must NEVER be committed.
# This file is committed on purpose — it documents every key the app needs.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Public URL of THIS backend.
# In local development with ngrok, set this to the ngrok HTTPS URL — payment
# providers must be able to reach the webhook endpoints from the internet.
APP_URL=http://localhost:4000

# Origins allowed to call this API (the Next.js frontend). Comma-separated.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# How long (seconds) the category tree stays cached before a rebuild.
CATEGORY_TREE_CACHE_TTL=3600

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_me_with_a_DIFFERENT_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Cost factor for password hashing. Higher = slower = harder to brute force.
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Stripe
# Test keys:  https://dashboard.stripe.com/test/apikeys
# Test mode keys start with sk_test_ / pk_test_
# Live mode keys start with sk_live_ / pk_live_
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret used to verify that a webhook really came from Stripe.
# Obtained from `stripe listen --forward-to ...` or the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

STRIPE_CURRENCY=usd

# ---------------------------------------------------------------------------
# bKash
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Live:    https://tokenized.pay.bka.sh/v1.2.0-beta
# ---------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_sandbox_username
BKASH_PASSWORD=your_bkash_sandbox_password

# Where bKash redirects the buyer after they approve or decline the payment.
BKASH_CALLBACK_URL=http://localhost:4000/api/v1/payments/bkash/callback

# When true, the bKash strategy runs against recorded sandbox fixtures instead
# of the live sandbox API. Lets the full checkout flow be demonstrated and
# tested while merchant sandbox credentials are still pending approval.
BKASH_MOCK=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Stricter limit for /auth routes — this is where credential stuffing happens.
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Seeding (php artisan db:seed equivalent)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
